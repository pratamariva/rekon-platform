# Rekon API — copy to .env and fill in. NEVER commit the real .env.
DATABASE_URL="postgresql://rekon:rekon@localhost:5432/rekon?schema=public"
NODE_ENV="development"
# Exact origin of the web app. Used for CORS + cookie. Never "*".
WEB_ORIGIN="http://localhost:5173"
# Cookie domain for session cookie. Leave blank for localhost; set to shared parent
# domain (e.g. ".rekon.app") in prod so api + web can share the session cookie.
COOKIE_DOMAIN=""
PORT="3000"
